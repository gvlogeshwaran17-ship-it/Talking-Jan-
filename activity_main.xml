<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <com.talkingjan.app.JanCharacterView
        android:id="@+id/janCharacterView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="40dp"
        android:background="@drawable/status_pill_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎤 Talk to Jan!"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/btnDrink"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="5dp"
            android:backgroundTint="#CC1E293B"
            android:padding="0dp"
            android:text="☕"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnEat"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="5dp"
            android:backgroundTint="#CC1E293B"
            android:padding="0dp"
            android:text="🍰"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnMic"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_margin="6dp"
            android:backgroundTint="#14B8A6"
            android:padding="0dp"
            android:text="🎙️"
            android:textSize="26sp" />

        <Button
            android:id="@+id/btnCymbal"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="5dp"
            android:backgroundTint="#CC1E293B"
            android:padding="0dp"
            android:text="🥁"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnDance"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="5dp"
            android:backgroundTint="#CC1E293B"
            android:padding="0dp"
            android:text="🎵"
            android:textSize="22sp" />
    </LinearLayout>

</FrameLayout>
